{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "MAX_MCP_OUTPUT_TOKENS": "12000",
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  },
  "permissions": {
    "deny": [
      "Read(./**/*.mp4)",
      "Read(./**/*.mov)",
      "Read(./**/*.avi)",
      "Read(./**/*.mkv)",
      "Read(./output_videos/**)",
      "Read(./temp/**)",
      "Read(./venv/**)",
      "Read(./env/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/node_modules/**)",
      "Read(./.env)"
    ]
  }
}
