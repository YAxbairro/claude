{
  "manifest_version": 3,
  "name": "VeloDown",
  "version": "1.0.0",
  "description": "Envia downloads e vídeos para o gestor de downloads VeloDown.",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "webRequest", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "VeloDown" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
