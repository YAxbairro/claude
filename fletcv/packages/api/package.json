{
  "name": "@fletcv/api",
  "version": "0.1.0",
  "description": "FletCV backend API (Fastify) over @fletcv/core. Multi-tenant, offline-sync friendly.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fletcv/core": "workspace:*",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
