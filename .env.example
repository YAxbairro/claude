# Configurações do Agente de Vídeos Imobiliários

# API Key da Anthropic (Claude)
# Obtém em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# (Opcional) Configurações adicionais podem ser adicionadas aqui

# =====================================================================
# ROBÔ IMOAUTO
# =====================================================================

# --- Essencial ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
TELEGRAM_BOT_TOKEN=            # cria o bot no @BotFather
TELEGRAM_CHAT_ID=              # o teu chat id (@userinfobot diz-te)

# --- Segurança de operação ---
IMOAUTO_DRY_RUN=1              # 1 = simula tudo, nada sai. Muda para 0 só
                               # quando já viste os rascunhos e confias.
IMOAUTO_APROVAR_POSTS=1        # 1 = nenhum post sai sem o teu botão

# --- WhatsApp Cloud API (Coexistence no número Business) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=imoauto  # o que escreveres aqui, escreves na Meta

# --- Meta Graph (Facebook Page + Instagram Business) ---
META_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_USER_ID=
META_GRAPH_VERSION=v21.0

# --- Site ImoAuto (conta de administrador) ---
IMOAUTO_SITE_URL=https://imoauto.pt
IMOAUTO_API_TOKEN=

# --- Flyers ---
OPENAI_API_KEY=
IMOAUTO_MODELO_IMAGEM=gpt-image-1

# --- País de operação (Cabo Verde por omissão) ---
IMOAUTO_PAIS=CV
IMOAUTO_INDICATIVO=238        # +238
IMOAUTO_DIGITOS_LOCAIS=7      # os números cabo-verdianos têm 7 dígitos
IMOAUTO_MOEDA=CVE

# --- Pesquisa (o Vigia precisa disto para varrer sozinho) ---
FIRECRAWL_API_KEY=

# --- Caixa de correio (avisos de grupos do Facebook) ---
# Liga as notificações do grupo em "Todas as publicações" + email, e o robô
# lê os avisos aqui. Ele lê o TEU email, não o Facebook.
EMAIL_SERVIDOR=imap.gmail.com
EMAIL_UTILIZADOR=
EMAIL_SENHA=                  # palavra-passe de APLICAÇÃO, não a normal
EMAIL_PASTA=INBOX

# --- Quem te ajuda a recolher (IDs de Telegram, separados por vírgulas) ---
# Podem mandar anúncios ao robô; não veem leads nem aprovam nada.
TELEGRAM_AJUDANTES=

# --- Opcional ---
IMOAUTO_DB=./imoauto.db
IMOAUTO_MEDIA=./media
IMOAUTO_MARCA=ImoAuto
